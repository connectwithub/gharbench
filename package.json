{
  "name": "gharbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Benchmark harness for evaluating LLM sales agents in WhatsApp-style Indian real-estate lead conversations.",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx src/run/smoke.ts",
    "smoke:live": "tsx src/run/smokeLive.ts",
    "stats:test": "vitest run --config vitest.stats.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "decisions:index": "node scripts/decisions-index.mjs docs/decisions && node scripts/decisions-index.mjs docs/decisions-private"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.104",
    "@ai-sdk/google": "3.0.103",
    "@ai-sdk/openai": "3.0.90",
    "ai": "6.0.239",
    "dotenv": "^17.2.3",
    "p-limit": "^7.1.1",
    "p-queue": "^9.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.13",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/connectwithub/gharbench.git"
  },
  "bugs": {
    "url": "https://github.com/connectwithub/gharbench/issues"
  },
  "homepage": "https://github.com/connectwithub/gharbench#readme"
}
