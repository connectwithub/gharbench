node_modules/
.env
.env.local

# Run outputs: transcripts, manifests, cost reports.
runs/

# G16: the held-out private scenario pool must never enter version control.
# Publishing it would let a contestant train or hand-tune against the exact
# tasks it is scored on, which destroys the benchmark's discriminative power.
# Keep it local (or in a separate access-controlled store) forever.
private-pool/

# Python (stats-bridge)
__pycache__/
*.pyc
.venv/
stats-bridge/.venv/

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# Build / tooling caches
dist/
coverage/
*.tsbuildinfo
.eslintcache

# Mirror of the private Claude project (Master Plan, personas, scenario
# taxonomy, compliance traps, judge rubrics, cost model, paper draft).
# Same reasoning as private-pool/ above: a contestant that can read the exact
# personas, traps and rubric can be tuned against them, and the score stops
# measuring sales capability. Re-create it locally with the endpoints in
# docs/claude-project/README.md.
docs/claude-project/

# Private half of the decision log (docs/decisions/ is the public half).
# Holds decisions a contestant could tune against: persona hidden fields,
# scenario taxonomy, trap construction, rubric internals, scoring thresholds,
# calibration composition, funding strategy. Same G16 reasoning as private-pool/.
docs/decisions-private/
