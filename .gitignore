node_modules/
.env
.env.local

# Run outputs: transcripts, manifests, cost reports.
runs/

# G16: the held-out private scenario pool must never enter version control.
# Publishing it would let a contestant train or hand-tune against the exact
# tasks it is scored on, which destroys the benchmark's discriminative power.
# Keep it local (or in a separate access-controlled store) forever.
private-pool/

# Phase 4 calibration set: transcripts + human reference labels the judge
# panel is validated against (Master Plan §4.5). The labels are an answer
# key - published, they let a judge prompt (or a contestant) be tuned
# against the exact cases that certify judge agreement, voiding G8/G8a.
# Same G16 reasoning as private-pool/; lives in the private overlay repo.
calibration/

# Python (stats-bridge)
__pycache__/
*.pyc
.venv/
stats-bridge/.venv/

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# Build / tooling caches
dist/
coverage/
*.tsbuildinfo
.eslintcache

# Local mirror of the private design source of truth (master plan, personas,
# scenario taxonomy, compliance traps, judge rubrics, cost model, paper draft).
# Same reasoning as private-pool/ above: a contestant that can read the exact
# personas, traps and rubric can be tuned against them, and the score stops
# measuring sales capability.
docs/claude-project/

# Private half of the decision log (docs/decisions/ is the public half).
# Holds decisions a contestant could tune against: persona hidden fields,
# scenario taxonomy, trap construction, rubric internals, scoring thresholds,
# calibration composition, funding strategy. Same G16 reasoning as private-pool/.
docs/decisions-private/

# Local working notes and the initial build brief. Version-controlled
# separately; they are scratch documents, not part of the published artifact.
# Durable decisions belong in docs/decisions/ instead.
CLAUDE.md
docs/GharBench_Phase0_Setup_Prompt.md
